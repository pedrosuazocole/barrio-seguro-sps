# Puerto del servidor (Railway lo define automáticamente)
PORT=3000

# Ruta de la base de datos SQLite. En Railway, usar un Volume montado en /data
# para que persista entre despliegues (el sistema de archivos es efímero).
DATABASE_PATH=./barrio_seguro.db

# NODE_ENV=production activa cookies "secure" (solo HTTPS). En local dejar vacío o "development".
NODE_ENV=development
